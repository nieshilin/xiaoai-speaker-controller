{
  "name": "xiaomi-speaker-controller",
  "version": "2.3.0",
  "private": true,
  "description": "小爱音箱控制台（Windows · Electron）：云端 MiNA 控制 + 网易云/QQ 音乐在线播放 + 语音播报 + 本地推流 + 自动检查更新",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/selfcheck.js",
    "e2e": "node scripts/e2e.js",
    "dist": "electron-builder --win",
    "shot": "electron . --shot",
    "icon": "electron scripts/make-icon.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.xiaomi.speaker",
    "productName": "XiaoAiSpeakerControl",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "小爱音箱控制台",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
